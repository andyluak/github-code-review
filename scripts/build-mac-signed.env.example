# Copy this file to scripts/build-mac-signed.env.local and fill in real values.
# The .local file is ignored by git.

# Required after the Developer ID Application certificate is installed in Keychain.
# You can get the exact value from:
#   security find-identity -v -p codesigning
APPLE_SIGNING_IDENTITY="Developer ID Application: Alex Tirim (UZQ88T5NC7)"

# Notarization option A: Apple ID + app-specific password.
# Create the app-specific password at https://account.apple.com/account/manage
APPLE_ID="you@example.com"
APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"
APPLE_TEAM_ID="UZQ88T5NC7"

# Notarization option B: App Store Connect API key.
# If you use this option, you can leave APPLE_ID / APPLE_PASSWORD / APPLE_TEAM_ID empty.
# APPLE_API_ISSUER="issuer-id"
# APPLE_API_KEY="key-id"
# APPLE_API_KEY_PATH="$HOME/keys/AuthKey_KEYID.p8"
